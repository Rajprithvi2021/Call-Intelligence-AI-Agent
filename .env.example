# --- Required -------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# --- Models (Gemini) ------------------------------------------------------
TRANSCRIPTION_PROVIDER=gemini            # gemini | deepgram
TRANSCRIPTION_MODEL=gemini-3.6-flash
ANALYST_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.6-flash
# Tried in order when a model is overloaded (503) or out of quota (429)
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest
ANALYST_THINKING_LEVEL=HIGH              # MINIMAL | LOW | MEDIUM | HIGH
JUDGE_THINKING_LEVEL=MEDIUM

# --- Search embeddings ----------------------------------------------------
EMBED_ENABLED=true                       # false = keyword search only
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768                            # changing this requires re-creating the vector columns
SEARCH_MAX_DISTANCE=0.36                 # cosine distance cutoff for semantic hits (tuned on the samples)
SEARCH_SEMANTIC_TOP_K=10

# --- Storage --------------------------------------------------------------
# Leave empty to use the local JSON store in data/store (dev only).
# Local Docker:  postgresql://postgres:postgres@localhost:5432/callintel
# Neon/Supabase: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# --- Behaviour ------------------------------------------------------------
REVIEW_THRESHOLD=0.7                     # items below this confidence go to human review
JOB_CONCURRENCY=1                        # calls processed at once (keep 1 on the free tier)

# --- Optional -------------------------------------------------------------
DEEPGRAM_API_KEY=                        # only for TRANSCRIPTION_PROVIDER=deepgram
API_URL=http://127.0.0.1:8000            # used by the Streamlit UI
