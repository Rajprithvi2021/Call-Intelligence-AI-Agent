# Copy to .env for local runs. On Railway, set these as service variables.
# Values must not contain comments: keep every comment on its own line.

# --- Required -------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# --- Models (Gemini) ------------------------------------------------------
# Transcription provider: gemini | deepgram
TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-3.6-flash
ANALYST_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.6-flash
# Tried in order when a model is overloaded (503) or out of quota (429)
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest
# Thinking levels: MINIMAL | LOW | MEDIUM | HIGH
ANALYST_THINKING_LEVEL=HIGH
JUDGE_THINKING_LEVEL=MEDIUM

# --- Search embeddings ----------------------------------------------------
# false = keyword search only
EMBED_ENABLED=true
GEMINI_EMBED_MODEL=gemini-embedding-001
# Changing the dimension requires re-creating the vector columns
EMBED_DIM=768
# Cosine distance cutoff for semantic hits (tuned on the sample calls)
SEARCH_MAX_DISTANCE=0.36
SEARCH_SEMANTIC_TOP_K=10

# --- Storage --------------------------------------------------------------
# Empty = local JSON store in data/store (dev only).
# Railway: ${{Postgres.DATABASE_URL}}
# Railway from your laptop: the Postgres service's DATABASE_PUBLIC_URL plus ?sslmode=require
# Neon/Supabase: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=
# Point at a Railway volume (e.g. /data/uploads) so uploaded audio survives redeploys
UPLOAD_DIR=data/uploads

# --- Behaviour ------------------------------------------------------------
# Items below this confidence go to human review
REVIEW_THRESHOLD=0.7
# Calls processed at once (keep 1 on the free tier)
JOB_CONCURRENCY=1

# --- Optional -------------------------------------------------------------
# Only for TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Used by the Streamlit UI service only
API_URL=http://127.0.0.1:8000
